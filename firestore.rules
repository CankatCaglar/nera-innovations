rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /systems/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /locations/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }
  }
}
